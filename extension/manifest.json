{
  "manifest_version": 3,
  "name": "MirrorUI",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "Clone any component as responsive Tailwind v4 HTML and Astro, inspect elements, and pull a page's colours, fonts and assets.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "MirrorUI (Alt+Shift+M)" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "debugger", "storage", "unlimitedStorage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Show or hide the MirrorUI toolbar"
    }
  },
  "sandbox": { "pages": ["preview.html"] },
  "web_accessible_resources": [
    { "resources": ["preview.html", "preview.js", "vendor/tailwindcss-browser.js"], "matches": ["<all_urls>"] }
  ]
}
